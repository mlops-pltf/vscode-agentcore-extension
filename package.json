{
  "name": "agentcore-chat",
  "displayName": "agentcore-chat",
  "description": "Direct chat with AWS AgentCore agents",
  "publisher": "internal-tools",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentcore-sidebar",
          "title": "AgentCore Chat",
          "icon": "media/robot.svg"
        }
      ]
    },
    "views": {
      "agentcore-sidebar": [
        {
          "type": "webview",
          "id": "agentcoreChatView",
          "name": "AgentCore Agents",
          "icon": "media/robot.svg"
        }
      ]
    },
    "configuration": {
      "title": "AgentCore Chat",
      "properties": {
        "agentcore.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter with boto3 installed"
        },
        "agentcore.mock": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use a built-in **mock** AgentCore instead of AWS. For local development and demos; replies are fake."
        },
        "agentcore.region": {
          "type": "string",
          "default": "eu-central-1",
          "markdownDescription": "AWS region for AgentCore. Defaults to `eu-central-1`; clear it to use the region from your AWS profile instead."
        },
        "agentcore.a2aStreaming": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "For **A2A** agents, use `message/stream` (live status and streamed text) instead of `message/send`. Only enable if your A2A agents support streaming."
        },
        "agentcore.debugRawResponses": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log every raw response line to the **AgentCore Chat** Output channel. Useful for capturing real responses as test fixtures; may log sensitive content."
        }
      }
    },
    "commands": [
      {
        "command": "agentcore.openChat",
        "title": "Open Chat",
        "category": "AgentCore"
      },
      {
        "command": "agentcore.showLogs",
        "title": "Show Logs",
        "category": "AgentCore"
      },
      {
        "command": "agentcore.restartBackend",
        "title": "Restart Backend",
        "category": "AgentCore"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "test:js": "node --test --test-concurrency=1 test/node/*.spec.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "jsdom": "^24.1.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
